<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="shellRoot" fx:controller="ui.ShellController" styleClass="screen-bg" stylesheets="@ui.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
            <Label fx:id="titleLabel" styleClass="large-title" text="University Registration" HBox.hgrow="ALWAYS" />
            <Button fx:id="appearanceButton" mnemonicParsing="false" onAction="#onToggleAppearance" styleClass="plain-button" text="Dark" />
        </HBox>
    </top>
</BorderPane>
