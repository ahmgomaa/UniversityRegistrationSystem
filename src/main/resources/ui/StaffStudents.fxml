<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="ui.StaffStudentsController" spacing="12" styleClass="screen" stylesheets="@ui.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <Label styleClass="title" text="All students" />
    <HBox spacing="12">
        <VBox maxWidth="Infinity" spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="totalValue" styleClass="stat-value, accent-text" text="0" />
            <Label styleClass="stat-caption" text="STUDENTS" />
        </VBox>
        <VBox maxWidth="Infinity" spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="activeValue" styleClass="stat-value, green-text" text="0" />
            <Label styleClass="stat-caption" text="ACTIVE" />
        </VBox>
        <VBox maxWidth="Infinity" spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="probationValue" styleClass="stat-value, orange-text" text="0" />
            <Label styleClass="stat-caption" text="ON PROBATION" />
        </VBox>
    </HBox>
    <ScrollPane fx:id="studentsListScroll" id="staff-students-list" fitToWidth="true" hbarPolicy="NEVER" minHeight="120" prefHeight="220" styleClass="row-table" VBox.vgrow="ALWAYS" />
    <Label fx:id="detailLabel" minHeight="-Infinity" managed="false" maxWidth="Infinity" styleClass="card" visible="false" wrapText="true" />
    <VBox fx:id="actionsBox" managed="false" spacing="12" visible="false">
        <Label fx:id="actionsLabel" styleClass="section-label" />
        <Button id="staff-student-status-button" maxWidth="Infinity" mnemonicParsing="false" onAction="#onStatus" styleClass="plain-button" text="Update Status" />
        <Button id="staff-student-advisor-button" maxWidth="Infinity" mnemonicParsing="false" onAction="#onAdvisor" styleClass="plain-button" text="Assign Advisor" />
    </VBox>
</VBox>
