<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="ui.InstructorController" spacing="12" styleClass="screen" stylesheets="@ui.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <Label styleClass="title" text="Record grades" />
    <HBox spacing="12">
        <VBox maxWidth="Infinity" spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="studentsValue" styleClass="stat-value, accent-text" text="0" />
            <Label styleClass="stat-caption" text="STUDENTS" />
        </VBox>
        <VBox maxWidth="Infinity" spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="gradedValue" styleClass="stat-value, green-text" text="0" />
            <Label styleClass="stat-caption" text="GRADED" />
        </VBox>
        <VBox maxWidth="Infinity" spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="pendingValue" styleClass="stat-value, orange-text" text="0" />
            <Label styleClass="stat-caption" text="PENDING" />
        </VBox>
    </HBox>
    <VBox spacing="10" styleClass="card">
        <Label styleClass="section-label" text="SECTION" />
        <ComboBox fx:id="sectionBox" id="instructor-section-box" maxWidth="Infinity" onAction="#onSectionChosen" />
    </VBox>
    <VBox fx:id="rosterPane" spacing="12" VBox.vgrow="ALWAYS">
        <Label styleClass="section-label" text="ROSTER" />
        <ScrollPane fx:id="rosterListScroll" id="instructor-roster-list" fitToWidth="true" hbarPolicy="NEVER" minHeight="120" prefHeight="220" styleClass="row-table" VBox.vgrow="ALWAYS" />
    </VBox>
    <VBox fx:id="gradePane" managed="false" spacing="12" visible="false">
        <Label styleClass="section-label" text="RECORD GRADE" />
        <Label fx:id="doneLabel" managed="false" styleClass="card" maxWidth="Infinity" visible="false" wrapText="true" />
        <VBox fx:id="formCard" spacing="10" styleClass="card">
            <Label fx:id="whoLabel" />
            <TextField fx:id="scoreField" id="instructor-score-field" promptText="Score (0–100)" />
            <Button id="instructor-record-button" maxWidth="Infinity" mnemonicParsing="false" onAction="#onRecord" styleClass="primary-button" text="Record Grade" />
        </VBox>
    </VBox>
    <Label fx:id="statusLabel" maxWidth="Infinity" wrapText="true" />
    <Button id="instructor-signout" maxWidth="Infinity" mnemonicParsing="false" onAction="#onSignOut" styleClass="plain-button" text="Sign Out" />
</VBox>
